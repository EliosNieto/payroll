<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.entic.payroll</groupId>
    <artifactId>entic-payroll</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <modules>
        <module>payroll-api</module>
        <module>payroll-core</module>
        <module>payroll-security</module>
        <module>payroll-shared</module>
        <module>payroll-electronic</module>
        <module>payroll-persistence</module>
        <module>payroll-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.entic.payroll</groupId>
                <artifactId>payroll-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entic.payroll</groupId>
                <artifactId>payroll-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entic.payroll</groupId>
                <artifactId>payroll-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entic.payroll</groupId>
                <artifactId>payroll-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
